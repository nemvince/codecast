# Copy to .env and fill in. Bun loads .env by itself; the compose services take it as env_file.

# Postgres. Keep the credentials in step with the compose service.
DATABASE_URL="postgresql://codecast:codecast@localhost:5432/codecast"

# The code execution engine. Inside the compose network: http://piston:2000
PISTON_URL="http://localhost:2000"

# Session signing key. Generate one: openssl rand -base64 32
AUTH_SECRET="replace-me-openssl-rand-base64-32"

# Public origin of this deployment. Must be https in production: it drives the OAuth callback and
# the Secure flag on session cookies.
BASE_URL="http://localhost:3000"

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL: <BASE_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
